# Local backend configuration.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/routecraft
SPRING_DATASOURCE_USERNAME=routecraft
SPRING_DATASOURCE_PASSWORD=routecraft
ROUTECRAFT_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ROUTECRAFT_FRONTEND_BASE_URL=http://localhost:3000
ROUTECRAFT_OAUTH_STATE_SECRET=routecraft-dev-oauth-state-secret-change-me

# Routing: Rust passed the recorded adoption gates. Set java for immediate rollback.
ROUTECRAFT_ROUTING_ENGINE=rust
ROUTECRAFT_ENGINE_URL=http://localhost:8090
ROUTECRAFT_ENGINE_BUDGET_SECONDS=30

# Optional Strava OAuth app credentials. Users connect per-account via
# /api/auth/strava/connect. Without client credentials, Strava uses mock data.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_OAUTH_REDIRECT_URI=http://localhost:18080/api/auth/strava/callback
