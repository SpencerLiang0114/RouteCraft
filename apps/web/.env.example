# Strava OAuth credentials are optional. Without them the Strava flow falls back
# to local mock route data.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# Spring Boot route-generation API URL.
# - NEXT_PUBLIC_ROUTECRAFT_API_URL is read by browser code in src/frontend/api/.
# - ROUTECRAFT_API_URL is read by Next.js server-side code (geocode + Strava proxies).
# Database credentials and any external API keys live only in services/routecraft-api/
# (configured via docker-compose.yml or application.properties).
ROUTECRAFT_API_URL=http://localhost:18080
NEXT_PUBLIC_ROUTECRAFT_API_URL=http://localhost:18080
